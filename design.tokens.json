{
  "color": {
    "$type": "color",
    "lantern-red": {
      "$value": "#c6301d",
      "$description": "Next action, done marks, today, focus ring"
    },
    "lantern-red-press": {
      "$value": "#a72614",
      "$description": "Pressed primary action"
    },
    "lantern-red-text": {
      "$value": "#a72614",
      "$description": "Red text under 18px: links, current lesson title (APCA Lc 76 on paper)"
    },
    "lantern-red-wash": {
      "$value": "#f6e1db",
      "$description": "Quiet red fill: today's day cell"
    },
    "sunflower": {
      "$value": "#fec33e",
      "$description": "Secondary, the logo tile yellow: brand and reward fills (splash, gate pass, milestone chips). Fill only; text on it is Ink (10.97:1), never white (1.6:1)"
    },
    "sunflower-wash": {
      "$value": "#fff3d6",
      "$description": "Quiet sunflower fill: reward card or banner background behind Ink text (15.96:1)"
    },
    "freeze-blue": {
      "$value": "#3f73b0",
      "$description": "Streak Freeze only"
    },
    "notebook-paper": {
      "$value": "#f7f3ea",
      "$description": "Page background"
    },
    "shaded-paper": {
      "$value": "#efe9dc",
      "$description": "Recessed fill: locked lesson marks"
    },
    "ink": {
      "$value": "#1d1814",
      "$description": "Headings, primary text, active tab label"
    },
    "graphite": {
      "$value": "#4a423a",
      "$description": "Secondary text, inactive tab labels and icons"
    },
    "pencil": {
      "$value": "#655c51",
      "$description": "Meta text, captions, day labels"
    },
    "faint-pencil": {
      "$value": "#948a7e",
      "$description": "Chevrons, empty future-day rings"
    },
    "ruled-line": {
      "$value": "#ddd5c8",
      "$description": "Section dividers, cell borders, path line"
    },
    "white": {
      "$value": "#ffffff",
      "$description": "Label and icons on Lantern Red"
    },
    "primary": {
      "$value": "{color.lantern-red}"
    },
    "secondary": {
      "$value": "{color.sunflower}"
    },
    "text": {
      "$value": "{color.ink}"
    },
    "muted": {
      "$value": "{color.pencil}"
    },
    "background": {
      "$value": "{color.notebook-paper}"
    },
    "border": {
      "$value": "{color.ruled-line}"
    },
    "frost-tint": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.98039,
          0.96471,
          0.93333
        ],
        "alpha": 0.72
      },
      "$description": "rgba(250,246,238,.72): milky fill behind blur for the tab bar and chips"
    },
    "frost-rim": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "alpha": 0.9
      },
      "$description": "1px inset white top highlight"
    },
    "frost-edge": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.15686,
          0.09804,
          0.05882
        ],
        "alpha": 0.1
      },
      "$description": "rgba(40,25,15,.10): .5px tab-bar border"
    },
    "frost-pill": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "alpha": 0.62
      },
      "$description": "Selection pill at rest; white top rim, faint shadow"
    },
    "frost-inner": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.15686,
          0.07843,
          0.03922
        ],
        "alpha": 0.08
      },
      "$description": "rgba(40,20,10,.08): 1px inset shade along the bottom edge of the tab-bar pill"
    },
    "frost-sheen-top": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "alpha": 0.45
      },
      "$description": "White at 45%: top of the pill's glass sheen gradient"
    },
    "frost-sheen-clear": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "alpha": 0
      },
      "$description": "White at 0%: where the sheen gradient fades out (not transparent: black at 0% would shift the midtones)"
    },
    "frost-sheen-glow": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "alpha": 0.25
      },
      "$description": "White at 25%: soft glow rising from the pill's bottom edge"
    },
    "frost-divider": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.15686,
          0.09804,
          0.05882
        ],
        "alpha": 0.18
      },
      "$description": "rgba(40,25,15,.18): 1px divider between facts in a Chip"
    },
    "lift-rim": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "alpha": 0.18
      },
      "$description": "White 18% inset highlight on the primary button"
    },
    "scrim": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.11373,
          0.09412,
          0.07843
        ],
        "alpha": 0.5
      },
      "$description": "Ink 50%: scrim behind Sheet and Dialog"
    }
  },
  "font": {
    "$type": "fontFamily",
    "serif": {
      "$value": [
        "Literata",
        "serif"
      ]
    },
    "sans": {
      "$value": [
        "Be Vietnam Pro",
        "system-ui",
        "sans-serif"
      ]
    },
    "pinyin": {
      "$value": [
        "Onest",
        "system-ui",
        "sans-serif"
      ],
      "$description": "Pinyin with tone marks; Be Vietnam Pro lacks ǎ ǐ ǒ ǔ ǖ ǘ ǚ ǜ (U+01CD–01DC)"
    },
    "hanzi": {
      "$value": [
        "AR PL UKai CN",
        "Kaiti SC",
        "STKaiti",
        "KaiTi",
        "serif"
      ]
    },
    "hanzi-xingshu": {
      "$value": [
        "Zhi Mang Xing",
        "cursive"
      ],
      "$description": "Learner toggle only"
    }
  },
  "text": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.serif}",
        "fontSize": {
          "value": 36,
          "unit": "px"
        },
        "fontWeight": 600,
        "lineHeight": 1,
        "letterSpacing": {
          "value": -0.01,
          "unit": "em"
        }
      }
    },
    "headline": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.serif}",
        "fontSize": {
          "value": 23,
          "unit": "px"
        },
        "fontWeight": 600,
        "lineHeight": 1.2
      }
    },
    "title": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.serif}",
        "fontSize": {
          "value": 17,
          "unit": "px"
        },
        "fontWeight": 600,
        "lineHeight": 1.3
      }
    },
    "action": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.serif}",
        "fontSize": {
          "value": 21,
          "unit": "px"
        },
        "fontWeight": 600,
        "lineHeight": 1
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": {
          "value": 16,
          "unit": "px"
        },
        "fontWeight": 400,
        "lineHeight": 1.5
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": {
          "value": 13.5,
          "unit": "px"
        },
        "fontWeight": 400,
        "lineHeight": 1.35
      }
    },
    "tab": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": {
          "value": 11.5,
          "unit": "px"
        },
        "fontWeight": 600,
        "lineHeight": 1
      }
    },
    "chip": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": {
          "value": 15,
          "unit": "px"
        },
        "fontWeight": 600,
        "lineHeight": 1
      },
      "$description": "Chip facts"
    },
    "toast": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": {
          "value": 14,
          "unit": "px"
        },
        "fontWeight": 500,
        "lineHeight": 1.5
      },
      "$description": "Toast message and action"
    }
  },
  "spacing": {
    "$type": "dimension",
    "$value": {
      "value": 4,
      "unit": "px"
    },
    "$description": "Base unit: p-4 = 16px. DESIGN.md steps 4, 8, 12, 16, 20, 24, 32 = p-1…p-8"
  },
  "radius": {
    "$type": "dimension",
    "cell": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "action": {
      "$value": {
        "value": 18,
        "unit": "px"
      }
    },
    "pill": {
      "$value": {
        "value": 999,
        "unit": "px"
      }
    }
  },
  "motion": {
    "fade": {
      "$type": "duration",
      "$value": {
        "value": 260,
        "unit": "ms"
      },
      "$description": "--motion-fade: opacity/colour fades on the tab bar (prototype roots.css transition .26s ease)"
    },
    "fade-reduced": {
      "$type": "duration",
      "$value": {
        "value": 150,
        "unit": "ms"
      },
      "$description": "--motion-fade-reduced: the same fades under prefers-reduced-motion (prototype .15s)"
    },
    "press": {
      "$type": "duration",
      "$value": {
        "value": 120,
        "unit": "ms"
      },
      "$description": "--motion-press: Button press scale and colour (prototype .12s)"
    },
    "scrim": {
      "$type": "duration",
      "$value": {
        "value": 150,
        "unit": "ms"
      },
      "$description": "--motion-scrim: scrim fade for Sheet and Dialog (prototype .15s)"
    },
    "sheet": {
      "$type": "duration",
      "$value": {
        "value": 280,
        "unit": "ms"
      },
      "$description": "--motion-sheet: bottom sheet slide (prototype .28s)"
    },
    "dialog": {
      "$type": "duration",
      "$value": {
        "value": 280,
        "unit": "ms"
      },
      "$description": "--motion-dialog: dialog pop, no overshoot (DESIGN.md: no bouncy UI)"
    },
    "toast": {
      "$type": "duration",
      "$value": {
        "value": 180,
        "unit": "ms"
      },
      "$description": "--motion-toast: toast rise and fade (prototype .18s)"
    }
  },
  "shadow": {
    "lift": {
      "$type": "shadow",
