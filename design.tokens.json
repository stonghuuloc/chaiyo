        {
          "color": {
            "colorSpace": "srgb",
            "components": [
              0.65882,
              0.14902,
              0.07843
            ],
            "alpha": 0.28
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 10,
            "unit": "px"
          },
          "blur": {
            "value": 24,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        }
      ],
      "$description": "Primary button lift: Press-red shadow (the only non-frost depth, DESIGN.md)"
    },
    "overlay": {
      "$type": "shadow",
      "$value": [
        {
          "color": {
            "colorSpace": "srgb",
            "components": [
              0.11373,
              0.09412,
              0.07843
            ],
            "alpha": 0.3
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 20,
            "unit": "px"
          },
          "blur": {
            "value": 60,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        }
      ],
      "$description": "Dialog float shadow"
    },
    "frost": {
      "$type": "shadow",
      "$value": [
        {
          "color": {
            "colorSpace": "srgb",
            "components": [
              0.17647,
              0.09804,
              0.03922
            ],
            "alpha": 0.16
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 10,
            "unit": "px"
          },
          "blur": {
            "value": 30,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        },
        {
          "color": {
            "colorSpace": "srgb",
            "components": [
              0.17647,
              0.09804,
              0.03922
            ],
            "alpha": 0.08
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 1,
            "unit": "px"
          },
          "blur": {
            "value": 3,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        }
      ],
      "$description": "Frost float: soft brown ambient shadow under tab bar and chips"
    }
  },
  "inset-shadow": {
    "lift": {
      "$type": "shadow",
      "$value": [
        {
          "color": "{color.lift-rim}",
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 1,
            "unit": "px"
          },
          "blur": {
            "value": 0,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          },
          "inset": true
        }
      ],
      "$description": "1px white top highlight on the primary button"
    },
    "frost": {
      "$type": "shadow",
      "$value": [
        {
          "color": "{color.frost-rim}",
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 1,
            "unit": "px"
          },
          "blur": {
            "value": 0,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          },
          "inset": true
        }
      ],
      "$description": "1px white top highlight on frosted surfaces"
    }
  },
  "blur": {
    "frost": {
      "$type": "dimension",
      "$value": {
        "value": 24,
        "unit": "px"
      },
      "$description": "backdrop-filter blur radius"
    }
  },
  "container": {
    "column": {
      "$type": "dimension",
      "$value": {
        "value": 430,
        "unit": "px"
      },
      "$description": "Single phone column and Sheet width (max-w-column)"
    },
    "dialog": {
      "$type": "dimension",
      "$value": {
        "value": 340,
        "unit": "px"
      },
      "$description": "Dialog max width, locked (max-w-dialog)"
    }
  },
  "frost": {
    "saturate": {
      "$type": "number",
      "$value": 1.75,
      "$description": "backdrop-filter saturate(175%)"
    }
  },
  "icon": {
    "duo": {
      "$type": "number",
      "$value": 0.5,
      "$description": "--duo: opacity of the Solar duotone second layer (default; 1 on red icons)"
    },
    "duo-c": {
      "$type": "color",
      "$value": "#f2cfc6",
      "$description": "--duo-c: second-layer colour on the streak flame; default elsewhere is currentColor, so ink at 50%. The active tab inverts it: Lantern Red --duo-c at --duo 1 with Lantern Red Wash detail"
    }
  },
  "$extensions": {
    "community.design-tokens.contrast": {
      "pairs": [
        [
          "ink",
          "notebook-paper",
          "body"
        ],
        [
          "graphite",
          "notebook-paper",
          "body"
        ],
        [
          "pencil",
          "notebook-paper",
          "body"
        ],
        [
          "lantern-red",
          "notebook-paper",
          "non-body"
        ],
        [
          "lantern-red-text",
          "notebook-paper",
          "body"
        ],
        [
          "ink",
          "lantern-red-wash",
          "body"
        ],
        [
          "lantern-red",
          "lantern-red-wash",
          "graphic"
        ],
        [
          "white",
          "lantern-red",
          "non-body"
        ],
        [
          "white",
          "lantern-red-press",
          "non-body"
        ],
        [
          "pencil",
          "shaded-paper",
          "graphic"
        ],
        [
          "faint-pencil",
          "notebook-paper",
          "graphic"
        ],
        [
          "ink",
          "sunflower",
          "body"
        ],
        [
          "ink",
          "sunflower-wash",
          "body"
        ],
        [
          "lantern-red",
          "sunflower",
          "graphic"
        ],
        [
          "freeze-blue",
          "notebook-paper",
          "graphic"
        ]
      ]
    },
    "community.design-tokens.brand": {
      "mood": [
        "calm",
        "bookish",
        "warm"
      ],
      "imageryStyle": "Cast art in a cute chibi style with thin dark brown outlines and flat pale colours, tiny shiny dot eyes and pink blush ovals, as the one rich, warm image per screen, cropped 3:2, with no text inside it; the interface around it stays flat ink on notebook paper.",
      "avoid": [
        "emoji in the interface",
        "toy-like or bouncy cartoon UI",
        "rainbow gradients",
        "busy multi-colour dashboards",
        "card shadows on scrolling content"
      ]
    }
  }
}
