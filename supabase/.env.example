# Google OAuth web client for the Supabase Auth Google provider (config.toml env() substitution).
# Copy to supabase/.env and fill in. Never put these in the root .env, chat or git.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# Resend API key (re_...) for the hosted project's SMTP; read by [remotes.hosted.auth.email.smtp]. Sandbox sender onboarding@resend.dev.
RESEND_API_KEY=
# Edge Functions (notify, email-test) read RESEND_API_KEY and RESEND_FROM from `supabase secrets set RESEND_API_KEY=... RESEND_FROM='Chaiyo <nhac@your-domain>'`, not from the SMTP env() above.
RESEND_FROM=
# Web Push (CHY-48): VAPID private key pair as JSON (publicKey/privateKey JWKs) and a contact URI.
# Print VAPID_KEYS with scripts/vapid-keys.ts, then: supabase secrets set VAPID_KEYS='...' VAPID_SUBJECT=mailto:you@example.com
VAPID_KEYS=
VAPID_SUBJECT=mailto:
# Telegram (CHY-48): bot token from @BotFather and a random webhook secret (A-Z a-z 0-9 _ -, 1-256 chars).
# supabase secrets set TELEGRAM_BOT_TOKEN=... TELEGRAM_WEBHOOK_SECRET=...
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# After `supabase functions deploy telegram-bot telegram-test notify`, point the bot at the webhook:
# curl -sS "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook" -d url=https://<ref>.supabase.co/functions/v1/telegram-bot -d secret_token=$TELEGRAM_WEBHOOK_SECRET
