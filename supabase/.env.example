# Google OAuth web client for the Supabase Auth Google provider (config.toml env() substitution).
# Copy to supabase/.env and fill in. Never put these in the root .env, chat or git.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# Gmail app password (16 chars) for the hosted project's SMTP (stonghuuloc@gmail.com); read by [remotes.hosted.auth.email.smtp].
SUPABASE_AUTH_SMTP_PASS=
