# Google OAuth web client for the Supabase Auth Google provider (config.toml env() substitution).
# Copy to supabase/.env and fill in. Never put these in the root .env, chat or git.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# Resend API key (re_...) for the hosted project's SMTP; read by [remotes.hosted.auth.email.smtp]. Sandbox sender onboarding@resend.dev.
RESEND_API_KEY=
