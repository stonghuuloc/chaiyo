{
	"name": "chaiyo",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync && paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide || echo ''",
		"check": "svelte-kit sync && paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker --noEmit",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "vitest --run --passWithNoTests",
		"test:coverage": "vitest --run --coverage",
		"lint:content": "tsx scripts/lint-content.ts",
		"import:content": "tsx scripts/import-content.ts",
		"tts:spike": "tsx scripts/tts-spike.ts",
		"check:syllable-clips": "tsx scripts/check-syllable-clips.ts",
		"tokens": "node scripts/build-tokens.mjs",
		"icons": "node scripts/build-icons.mjs",
		"brand": "scripts/build-brand.sh",
		"assets:push": "python3 scripts/assets_push.py",
		"assets:pull": "python3 scripts/assets_pull.py",
		"fonts": "python3 scripts/build-kaishu-subsets.py",
		"supabase:push": "scripts/supabase-push.sh"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.15",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/literata": "^5.3.0",
		"@fontsource/be-vietnam-pro": "^5.3.0",
		"@iconify-json/solar": "^1.2.13",
		"@inlang/paraglide-js": "^2.18.2",
		"@sveltejs/adapter-vercel": "^7.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@types/pg": "^8.23.1",
		"@vitest/coverage-v8": "^4.1.12",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"pg": "^8.23.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"yaml": "^2.9.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@sentry/sveltekit": "^11.10.0",
		"@supabase/supabase-js": "^2.118.0",
		"@vercel/speed-insights": "^2.0.0",
		"zod": "^4.6.7"
	}
}
