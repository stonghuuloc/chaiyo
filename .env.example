# Supabase project (Settings → API). Public values; RLS guards the data.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Cloudflare R2 (private bucket chaiyo-assets) for scripts/assets_*.py. Secrets: set in .env only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public clip bucket for scripts/render-audio.ts (CHY-15): its own bucket and token; R2_ACCOUNT_ID is shared.
# R2_PUBLIC_URL is the bucket public base URL (r2.dev or custom domain). Secrets: set in .env only.
R2_AUDIO_BUCKET=
R2_AUDIO_ACCESS_KEY_ID=
R2_AUDIO_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
# App-side base URL of the same clips (CHY-16): the R2_PUBLIC_URL value; empty serves /audio on the app origin.
PUBLIC_AUDIO_BASE_URL=
# Web Push public key (CHY-48, base64url, public by design); print with scripts/vapid-keys.ts. Empty disables push.
PUBLIC_VAPID_PUBLIC_KEY=
# Telegram bot username without @ (CHY-48); builds the t.me link and the @bot copy. Empty hides the Telegram row.
PUBLIC_TELEGRAM_BOT=
# Comma list of admin emails (CHY-50); shows admin menu rows only. Empty = none.
PUBLIC_ADMIN_EMAILS=
# Sentry (optional; unset = disabled). The DSN is public.
PUBLIC_SENTRY_DSN=
# Source-map upload: set these in Vercel project settings only, not in a local .env.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_URL=
# OmniVoice TTS spike (CHY-14): path to the venv python that has omnivoice installed
OMNIVOICE_PYTHON=
